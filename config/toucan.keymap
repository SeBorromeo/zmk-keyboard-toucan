#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi> // Requires zmk-auto-layer module.
#include <zmk-helpers/helper.h> // Requires zmk-helpers module.
#include "zmk-helpers/key-labels/42.h"
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define _BT_SEL_KEYS_                                                        \
    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR

#define BASE 0
#define NAV  1
#define SYM  2
#define FUN  3
#define NUM  4

#define XXX &none
#define ___ &trans

/* Global defaults */

#define QUICK_TAP_MS 175

&sk {
  release-after-ms = <900>;
  quick-release;
};

&sl { // Allow sticky mods to chord across sticky layers.
  ignore-modifiers;
};

&lt {
  flavor = "balanced";
  tapping-term-ms = <200>;
  quick-tap-ms = <QUICK_TAP_MS>;
};

#include "combos.dtsi" // Must be sourced after HRM-combo hack.

/* Homerow mods */

ZMK_HOLD_TAP(hrm, bindings = <&kp>, <&kp>; flavor = "balanced";             \
             tapping-term-ms = <280>; quick-tap-ms = <QUICK_TAP_MS>;         \
             require-prior-idle-ms = <150>; hold-trigger-on-release;)

/* Keymap */

ZMK_LAYER(BASE,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp TAB       &kp Q         &kp W         &kp E         &kp R         &kp T           &kp Y         &kp U         &kp I         &kp O         &kp P         &kp BSPC     
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &lt 4 BSPC    &hrm LSHFT A  &hrm LCTRL S  &hrm LALT D   &hrm LGUI F   &kp G           &kp H         &hrm RGUI J   &hrm RALT K   &hrm RCTRL L  &hrm RSHFT SQT &lt 3 SQT     
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &sk LSHFT     &kp Z         &kp X         &kp C         &kp V         &kp B           &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH      &mo 1        
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┤─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                              &mo NUM       &mo NAV       &lt SYM SPACE   &lt SYM SPACE &mo NAV       &mo FUN
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(NAV,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    ___           ___           ___           &kp LS(LC(TAB)) &kp LC(TAB)   ___             ___           &kp HOME       &kp PG_UP     &kp DOWN     ___           ___     
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           &hrm LSHFT DEL ___          &hrm LALT LS(TAB) &hrm LGUI TAB ___             &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     ___           ___       
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           &studio_unlock ___          ___           ___           ___             ___           ___           &kp PG_DN     ___           ___           ___       
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┤─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                              ___           ___           ___             ___           ___           ___
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(SYM,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    ___           &kp GRAVE     &kp LESS_THAN &kp GREATER_THAN &kp MINUS  &kp UNDER       &kp LCTRL     &kp RIGHT_BRACE &kp LEFT_BRACE &kp DOLLAR  &kp PIPE      ___       
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           &kp EXCL      &kp ASTRK     &kp FSLH      &kp EQUAL     &kp AMPERSAND   &kp HASH      &kp SEMI      &kp RIGHT_PARENTHESIS &kp LEFT_PARENTHESIS &kp DOUBLE_QUOTES ___ 
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           &kp TILDE     &kp PLUS      &kp LBKT      &kp RBKT      &kp PERCENT     &kp AT_SIGN   &kp COLON     &kp COMMA     &kp DOT       &kp BSLH      ___       
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┤─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                              ___           ___           ___             ___           ___           ___
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(FUN,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    ___           &kp F1        &kp F2        &kp F3        &kp F4        ___             &kp C_VOL_DN  &kp C_MUTE    &kp C_VOL_UP  ___           ___           &kp BSPC     
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           &hrm LSHFT F5 &hrm LCTRL F6 &hrm LALT F7  &hrm LGUI F8  ___             &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4       
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           &kp F9        &kp F10       &kp F11       &kp F12       ___             ___           ___           ___           ___           ___           ___       
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┤─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                              ___           ___           ___             ___           ___           ___
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(NUM,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    ___           ___           ___           ___           ___           ___             &kp STAR      &kp N7        &kp N8        &kp N9        &kp MINUS     ___          
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           ___           ___           ___           ___           ___             &kp DOT       &hrm RGUI N4  &hrm RALT N5  &hrm RCTRL N6 &hrm RSHFT PLUS      ___          
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           ___           ___           ___           ___           ___             &kp N0        &kp N1        &kp N2        &kp N3        &kp FSLH      ___          
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┤─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                              ___           ___           ___             ___           ___           ___   
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
)